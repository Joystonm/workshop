# Workshop Environment Variables
# Copy this file to .env.local and fill in your values

# MiniMax API (GMI Cloud)
# Get your API key from: https://console.gmicloud.ai/
MINIMAX_API_KEY=your_minimax_api_key_here
MINIMAX_API_URL=https://console.gmicloud.ai/user-console/ie/model-hub/llm/3c25d31e-d652-4d0b-bb0f-24476766da32

# Firecrawl
# Get your API key from: https://firecrawl.dev/
FIRECRAWL_API_KEY=your_firecrawl_api_key_here
FIRECRAWL_API_URL=https://api.firecrawl.dev/v0

# AgentMail
# Get your API key from: https://agentmail.io/
AGENTMAIL_API_KEY=your_agentmail_api_key_here
AGENTMAIL_INBOX_ID=your_inbox_id_here

# Convex
# These are automatically set when you run `npx convex dev`
# CONVEX_DEPLOYMENT=
# CONVEX_DEPLOY_KEY=
# PUBLIC_CONVEX_DEPLOYMENT=
